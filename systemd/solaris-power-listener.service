[Unit]
Description=Solaris Extraterrestrial Power Mode Audio Listener
After=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=%h/.local/bin/solaris-power-listener
Restart=always
RestartSec=3
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=/run/user/1000/pulse/native

[Install]
WantedBy=default.target
