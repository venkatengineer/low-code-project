#!/usr/bin/env bash
# Aetheris Holographic Desktop Overlay Launcher for Arch Linux / Wayland
set -e

if [[ "$1" == "--kill" || "$1" == "--quit" || "$1" == "--stop" ]]; then
    pkill -f "aetheris/runtime/electron" 2>/dev/null || true
    echo "[Aetheris] Terminated Aetheris overlay."
    exit 0
fi

APP_DIR="${HOME}/.local/share/aetheris/app"
RUNTIME="${HOME}/.local/share/aetheris/runtime/electron"

if [[ ! -f "$RUNTIME" ]]; then
    echo "[Aetheris Error] Electron runtime not found at $RUNTIME" >&2
    exit 1
fi

OZONE_FLAGS=(
    "--ozone-platform-hint=auto"
    "--enable-features=UseOzonePlatform,WaylandWindowDecorations"
    "--enable-gpu-rasterization"
    "--enable-zero-copy"
)

exec "$RUNTIME" "${OZONE_FLAGS[@]}" "$APP_DIR/electron/main.cjs" "$@"
