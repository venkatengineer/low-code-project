def render_manual():
    print("\033[2J\033[H", end="")
    print("\033[1;38;2;0;240;255m╔═════════════════════════════════════════════════════════════════════════════════════════════════╗\033[0m")
    print("\033[1;38;2;0;240;255m║   🛸 SOLARIS SPACECRAFT COMMAND DECK // PRIMARY OPERATING MANUAL & COMMAND MATRIX 👽    ║\033[0m")
    print("\033[1;38;2;0;240;255m╚═════════════════════════════════════════════════════════════════════════════════════════════════╝\033[0m\n")

    for cat_data in HOTKEY_MANUAL:
        print(f"\033[1;38;2;0;180;235m┌── {cat_data['category']} ───────────────────────────────────────────────────────────────────\033[0m")
        for key, desc in cat_data['keys']:
            print(f"\033[38;2;40;60;80m│  \033[1;38;2;57;255;20m{key:<24}\033[38;2;223;248;246m{desc}\033[0m")
        print("\033[38;2;40;60;80m└─────────────────────────────────────────────────────────────────────────────────────────────┘\033[0m\n")

    print("\033[38;2;0;240;255m[ Press ENTER to open interactive command search, or Q to exit ]\033[0m")
    try:
        choice = input().strip().lower()
        if choice in ['q', 'exit']:
            return
        interactive_fzf_mode()
    except (KeyboardInterrupt, EOFError):
        pass

def interactive_fzf_mode():
    fzf_path = os.path.expanduser("~/.local/bin/fzf")
    if not os.path.exists(fzf_path):
        fzf_path = "fzf"

    lines = []
    for item in COMMAND_DATABASE:
        line = f"[{item['category'][:14]:<14}] {item['cmd']:<42} │ {item['desc']}"
        lines.append((line, item['cmd']))

    input_text = "\n".join([l[0] for l in lines])

    fzf_cmd = [
        fzf_path,
        "--ansi",
        "--header= ⟦ SOLARIS SPACECRAFT // COMMAND MATRIX ⟧ \n Select command to execute or copy (Esc to abort):",
        "--prompt=🛸 SOLARIS-CMD ❯ ",
        "--height=85%",
        "--reverse",
        "--border=rounded",
        "--color=bg+:#0a121c,fg+:#dff8f6,hl:#00f0ff,hl+:#39ff7a,pointer:#00f0ff,border:#0099ff,header:#00f0ff"
    ]

    try:
        proc = subprocess.Popen(fzf_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        selected_line, _ = proc.communicate(input=input_text)
        if proc.returncode == 0 and selected_line.strip():
            selected_line = selected_line.strip()
            for line, cmd in lines:
                if selected_line.startswith(line[:35]):
                    print(f"\n\033[1;38;2;0;240;255m⟦ COMMAND SELECTED ⟧\033[0m")
                    print(f"\033[1;37mCommand: \033[1;38;2;57;255;20m{cmd}\033[0m\n")
                    choice = input("Execute now? [Y/n/copy]: ").strip().lower()
                    if choice in ['', 'y', 'yes']:
                        print(f"\033[38;2;0;180;235m▶ Executing: {cmd}\033[0m\n")
                        subprocess.run(cmd, shell=True)
                    elif choice in ['c', 'copy']:
                        subprocess.run(f"echo -n {repr(cmd)} | wl-copy 2>/dev/null || true", shell=True)
                        print("\033[38;2;57;255;20m✔ Copied to Wayland clipboard!\033[0m")
                    return
    except Exception as e:
        print(f"Error launching interactive matrix: {e}", file=sys.stderr)

def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ['--manual', '-m', '--hotkeys', '-h', 'help']:
            render_manual()
            return
        query = " ".join(sys.argv[1:])
        results = [c for c in COMMAND_DATABASE if query.lower() in c['cmd'].lower() or query.lower() in c['desc'].lower() or any(query.lower() in t.lower() for t in c['tags'])]
        if not results:
            print(f"\n\033[38;2;255;42;95m[!] No matching spacecraft commands found for: '{query}'\033[0m\n")
            sys.exit(1)
        print(f"\n\033[1;38;2;0;240;255m╔═⟦ COMMAND RESULTS: '{query}' ⟧═══════════════════════════════════════════\033[0m")
        for item in results[:8]:
            print(f"\033[38;2;0;180;235m║ \033[1;38;2;57;255;20m{item['cmd']:<42}\033[38;2;100;130;155m │ {item['desc']}\033[0m")
        print("\033[1;38;2;0;240;255m╚════════════════════════════════════════════════════════════════════════════╝\033[0m\n")
    else:
        render_manual()

if __name__ == "__main__":
    main()
