#!/usr/bin/env python3
"""
🛸 SOLARIS SYSTEM-WIDE POWER PROFILE & GOVERNOR AUDIO DAEMON
Listens directly to Linux System DBus (net.hadess.PowerProfiles)
and plays sci-fi audio effects whenever the system power profile
changes via hardware hotkey, CLI, power supply AC plug/unplug, or UI.
"""

import os
import sys
import time
import signal
import subprocess
import gi
from gi.repository import Gio, GLib

last_play_time = 0.0
last_profile = None

def log(msg):
    ts = time.strftime("%Y-%m-%d %H:%M:%S")
    print(f"[{ts}] [Solaris Power Audio] {msg}", flush=True)

def is_audio_muted():
    """Returns True if the system audio sink is muted or volume is zero."""
    try:
        res = subprocess.run(
            ["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
            capture_output=True, text=True, timeout=1, check=False
        )
        if res.returncode == 0:
            out = res.stdout.strip()
            if "[MUTED]" in out:
                return True
            parts = out.split()
            if len(parts) >= 2:
                try:
                    vol = float(parts[1])
                    if vol <= 0.001:
                        return True
                except ValueError:
                    pass
    except Exception:
        pass

    try:
        res = subprocess.run(
            ["amixer", "get", "Master"],
            capture_output=True, text=True, timeout=1, check=False
        )
        if res.returncode == 0 and "[off]" in res.stdout:
            return True
    except Exception:
        pass

    return False

def handle_profile_change(new_profile):
    global last_play_time, last_profile
    now = time.time()
    
    # Debounce rapid duplicate signals within 0.4s
    if new_profile == last_profile and (now - last_play_time) < 0.4:
        return
    
    last_profile = new_profile
    last_play_time = now
    log(f"⚡ Power Profile Switch Triggered: {new_profile.upper()}")

    play_bin = "/home/venkatengineer/.local/bin/solaris-play-sound"
    audio_active = not is_audio_muted()
    if not audio_active:
        log("Audio is muted -- power mode switch remaining completely silent.")

    if new_profile == "performance":
        if audio_active:
            subprocess.Popen([play_bin, "warp"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen([
            "notify-send", "-a", "Solaris Reactor",
            "-i", "preferences-system-power",
            "-h", "string:x-canonical-private-synchronous:solaris-pwr",
            "⚡ WARP OVERCLOCK", "Maximum Frequency & Performance Governor Active"
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    elif new_profile == "balanced":
        if audio_active:
            subprocess.Popen([play_bin, "balanced"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen([
            "notify-send", "-a", "Solaris Reactor",
            "-i", "preferences-system-power",
            "-h", "string:x-canonical-private-synchronous:solaris-pwr",
            "🛸 ORBITAL BALANCED", "Nominal Flight Vector & Equilibrium Active"
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    elif new_profile in ("power-saver", "powersave", "quiet"):
        if audio_active:
            subprocess.Popen([play_bin, "cryo"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen([
            "notify-send", "-a", "Solaris Reactor",
            "-i", "preferences-system-power",
            "-h", "string:x-canonical-private-synchronous:solaris-pwr",
            "❄️ CRYO SAVER", "Low-Draw Thermal Conservation Active"
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def on_dbus_signal(connection, sender_name, object_path, interface_name, signal_name, parameters, user_data):
    try:
        if interface_name == "org.freedesktop.DBus.Properties" and signal_name == "PropertiesChanged":
            iface, changed, invalidated = parameters.unpack()
            if "ActiveProfile" in changed:
                new_p = changed["ActiveProfile"]
                handle_profile_change(new_p)
    except Exception as e:
        log(f"Error processing signal: {e}")

def main():
    signal.signal(signal.SIGINT, lambda s, f: sys.exit(0))
    signal.signal(signal.SIGTERM, lambda s, f: sys.exit(0))

    log("Connecting to System DBus...")
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    except Exception as e:
        log(f"Fatal: Could not connect to system bus: {e}")
        sys.exit(1)

    # Initial profile query
    try:
        res = subprocess.run(["powerprofilesctl", "get"], stdout=subprocess.PIPE, text=True, check=False)
        global last_profile
        last_profile = res.stdout.strip()
        log(f"Current initial profile: {last_profile}")
    except Exception:
        pass

    bus.signal_subscribe(
        "net.hadess.PowerProfiles",
        "org.freedesktop.DBus.Properties",
        "PropertiesChanged",
        "/net/hadess/PowerProfiles",
        None,
        Gio.DBusSignalFlags.NONE,
        on_dbus_signal,
        None
    )

    log("🛸 Solaris Power Audio Listener ONLINE & ARMED.")
    loop = GLib.MainLoop()
    loop.run()

if __name__ == "__main__":
    main()
